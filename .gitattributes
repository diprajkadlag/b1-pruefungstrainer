# Normalise line endings in the repository; check out native on Windows.
* text=auto

*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.tex   text eol=lf
*.j2    text eol=lf
*.sh    text eol=lf

# Windows launchers must keep CRLF or cmd.exe mis-parses them.
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Never touch binary assets.
*.mp3   binary
*.ogg   binary
*.wav   binary
*.webm  binary
*.onnx  binary
*.pdf   binary
*.png   binary
*.jpg   binary
