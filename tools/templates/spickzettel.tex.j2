%% ==========================================================================
%% 2 — Strategie
%% ==========================================================================
\spickteil{2 · Strategie für die vier Module}{Was man macht, bevor man kann}

<% for s in strategie %>
\spickunter{<< s.modul|tex >>  ·  {\normalfont\small\color{b1mute}<< s.zeitplan|tex >>}}

\begin{list}{}{\leftmargin=1.2em\itemsep=2pt\parsep=0pt\topsep=2pt
               \labelsep=0.4em\labelwidth=0.8em}
<% for g in s.goldregeln %>
  \item[\color{b1mark}\textbf{\textbullet}] \small << g|betont >>
<% endfor %>
\end{list}

<% if s.get('tipps') %>
\vspace{0.3em}
\begin{tabularx}{\linewidth}{@{}p{4.6cm} >{\raggedright\arraybackslash}X@{}}
\toprule
<% for t in s.tipps %>
\footnotesize\textbf{<< t.teil|tex >>} & \footnotesize << t.text|betont >> \\
<% if not loop.last %>\addlinespace[2pt]<% endif %>
<% endfor %>
\bottomrule
\end{tabularx}
<% endif %>

<% if s.get('aufgaben') %>
\vspace{0.3em}
<% for a in s.aufgaben %>
\needspace{5\baselineskip}
{\small\bfseries\color{b1mark}<< a.aufgabe|tex >>}\par
{\footnotesize\textbf{Aufbau:} << a.aufbau|tex >>}\par
{\footnotesize\color{b1mute}<< a.hinweis|betont >>}\par\vspace{0.35em}
<% endfor %>
<% endif %>

<% if s.get('teile') %>
\vspace{0.3em}
<% for t in s.teile %>
\needspace{6\baselineskip}
{\small\bfseries\color{b1mark}<< t.teil|tex >>}\par
{\footnotesize\textbf{Ziel:} << t.ziel|tex >>}\par
{\footnotesize\textbf{Ablauf:} << t.ablauf|tex >>}\par
{\footnotesize\color{b1mute}\textbf{Achtung:} << t.achtung|betont >>}\par\vspace{0.35em}
<% endfor %>
<% endif %>

<% if s.get('fehlerliste') %>
\vspace{0.4em}
\spickunter{Die zehn Fehler, die am meisten Punkte kosten}
\begin{multicols}{2}
<% for f in s.fehlerliste %>
\fehlerzeile{<< f.falsch|tex >>}{<< f.richtig|tex >>}{<< f.grund|tex >>}
<% endfor %>
\end{multicols}
<% endif %>

<% endfor %>

%% ==========================================================================
%% 3 — Redemittel
%% ==========================================================================
\spickteil{3 · Redemittel}{Sätze, die immer passen}

\merke{Lernen Sie aus jedem Block \textbf{zwei} Wendungen richtig auswendig,
  nicht alle zehn ungefähr. Zwei sichere Sätze, die Sie ohne Nachdenken
  abrufen, bringen in der Prüfung mehr als eine lange Liste, bei der Sie
  mitten im Satz überlegen müssen.}

<% for r in redemittel %>
\spickunter{<< r.bereich|tex >>}
\begin{multicols}{2}
<% for g in r.gruppen %>
\redeblock{<< g.funktion|tex >>}{%
<% for p in g.phrasen %>
  \redesatz{<< p|tex >>}
<% endfor %>
}
<% endfor %>
\end{multicols}
<% endfor %>

%% ==========================================================================
%% 4 — Grammatik
%% ==========================================================================
\spickteil{4 · Grammatik in Tabellen}{Fett = genau das, was man sich merken muss}

<% for gr in grammatik %>
\needspace{8\baselineskip}
\spickunter{<< gr.thema|tex >>}
{\small << gr.erklaerung|tex >>}\par\vspace{0.3em}
\begin{tabularx}{\linewidth}{@{}<% for _ in gr.tabelle.kopf %>>{\raggedright\arraybackslash}X <% endfor %>@{}}
\toprule
<% for k in gr.tabelle.kopf %>
\footnotesize\textbf{<< k|tex >>}<% if not loop.last %> & <% endif %>
<% endfor %>
 \\
\midrule
<% for z in gr.tabelle.zeilen %>
<% for c in z %>
\footnotesize << c|betont >><% if not loop.last %> & <% endif %>
<% endfor %>
 \\
<% endfor %>
\bottomrule
\end{tabularx}
\vspace{0.4em}
<% endfor %>

