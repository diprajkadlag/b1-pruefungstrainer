%% 5 — Wortschatz
%% ==========================================================================
\spickteil{5 · Grundwortschatz}{<< wortschatz.titel|tex >>}

\merke{<< wortschatz.hinweis|betont >>}

<# Counts come from the data, so they cannot drift as words are added. #>
<% set n_verben = wortschatz.verben|map(attribute='eintraege')|map('length')|sum %>
<% set n_nomen = wortschatz.nomen|map(attribute='eintraege')|map('length')|sum %>
\spickunter{<< n_verben >> Verben mit ihren Stammformen}

{\footnotesize
\setlength{\tabcolsep}{3pt}
% Ragged right throughout: these columns are too narrow to justify without
% stretched word spacing and hyphenated English glosses.
\setlength{\LTleft}{0pt}\setlength{\LTright}{0pt}
\begin{longtable}{@{}>{\raggedright\arraybackslash}p{3.5cm}
                    >{\raggedright\arraybackslash}p{3.1cm}
                    >{\raggedright\arraybackslash}p{1.6cm}
                    >{\raggedright\arraybackslash}p{1.7cm}
                    >{\raggedright\arraybackslash}p{2.4cm}
                    >{\raggedright\arraybackslash}p{4.0cm}@{}}
\toprule
\textbf{Infinitiv} & \textbf{Englisch} & \textbf{er/sie/es} &
  \textbf{Präteritum} & \textbf{Perfekt} & \textbf{Beispiel} \\
\midrule
\endfirsthead
\toprule
\textbf{Infinitiv} & \textbf{Englisch} & \textbf{er/sie/es} &
  \textbf{Präteritum} & \textbf{Perfekt} & \textbf{Beispiel} \\
\midrule
\endhead
\bottomrule
\endfoot
<% for g in wortschatz.verben %>
\addlinespace[2pt]
\multicolumn{6}{@{}l}{\color{b1mark}\bfseries << g.gruppe|tex >>} \\
\addlinespace[1pt]
\midrule
<% for v in g.eintraege %>
\textbf{<< v.inf|tex >>}<% if v.unreg %>\,$\blacktriangle$<% endif %> &
  << v.en|tex >> & << v['er']|tex >> & << v['prät']|tex >> &
  << v.perf|tex >> & << v.bsp|betont >> \\
<% endfor %>
<% endfor %>
\end{longtable}
}

\merke{$\blacktriangle$ = unregelmäßig. Aus den vier Stammformen lässt sich
  jede Zeitform bilden: \textbf{Präsens} aus dem Infinitiv (\emph{ich gehe}),
  \textbf{Perfekt} aus Hilfsverb + Partizip (\emph{ich bin gegangen}),
  \textbf{Präteritum} direkt (\emph{ich ging}), \textbf{Futur~I} aus
  \emph{werden} + Infinitiv (\emph{ich werde gehen}) und
  \textbf{Konjunktiv~II} aus \emph{würde} + Infinitiv (\emph{ich würde gehen}).}

