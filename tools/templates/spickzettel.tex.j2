% spickzettel.tex — the cheat sheet, generated from content/lernhilfe/.
%
% Unlike the exam documents this one is meant to be read rather than sat, so it
% runs narrower margins and a smaller body size: it is a reference the student
% flicks through, and page turns cost more here than white space does.
\documentclass[10pt,a4paper]{article}
\usepackage{b1pruefung}
\usepackage{longtable}
\usepackage{tabularx}
\usepackage{booktabs}
\usepackage{multicol}

\geometry{top=2.1cm,bottom=1.9cm,left=1.6cm,right=1.6cm,headheight=22pt}

\pruefungstitel{B1 Spickzettel}
\modulname{Strategie · Redemittel · Grammatik · Wortschatz}
\niveaustufe{B1}

\setlength{\parskip}{0.4em}
\linespread{1.02}
\setlength{\tabcolsep}{4pt}
\renewcommand{\arraystretch}{1.18}

% --- cheat-sheet furniture -------------------------------------------------
% Numbered banner that opens each of the four big sections.
\newcommand{\spickteil}[2]{%
  \needspace{6\baselineskip}
  \vspace{0.9em}
  \begin{tcolorbox}[colback=b1rule,colframe=b1rule,boxrule=0pt,arc=2pt,
                    left=9pt,right=9pt,top=5pt,bottom=5pt]
    {\large\bfseries\color{white}#1}%
    \hfill{\small\color{b1edge}#2}
  \end{tcolorbox}
  \vspace{0.2em}
}

\newcommand{\spickunter}[1]{%
  \needspace{4\baselineskip}
  \vspace{0.5em}
  {\bfseries\color{b1rule}#1}\par
  \vspace{0.1em}{\color{b1edge}\hrule height 0.7pt}\vspace{0.35em}
}

% \merke{body} — the rule worth carrying into the exam hall.
\newcommand{\merke}[1]{%
  \begin{tcolorbox}[colback=b1soft,colframe=b1mark,boxrule=0pt,arc=1pt,
                    leftrule=2.5pt,left=8pt,right=8pt,top=5pt,bottom=5pt,
                    before skip=5pt,after skip=6pt]
    \small #1
  \end{tcolorbox}
}

% One functional block of Redemittel: what you want to do, then how to say it.
% No \needspace here or in \fehlerzeile — both are set inside multicols, where
% needspace's page-breaking test does not apply and upsets column balancing.
\newcommand{\redeblock}[2]{%
  \par\vspace{0.35em}
  {\small\bfseries\color{b1mark}#1}\par\vspace{0.1em}
  \begin{list}{}{\leftmargin=0.9em\itemsep=1pt\parsep=0pt\topsep=1pt
                 \labelsep=0.35em\labelwidth=0.55em}
    #2
  \end{list}
}
\newcommand{\redesatz}[1]{\item[\color{b1edge}\textbullet] \small #1}

% Wrong-versus-right pair for the writing error list.
\newcommand{\fehlerzeile}[3]{%
  \par\vspace{0.3em}
  {\small\color{b1mute}$\times$\ #1}\par
  {\small\color{b1mark}$\checkmark$\ \textbf{#2}}\par
  {\footnotesize\color{b1mute}#3}\par
}

\begin{document}

\begin{tcolorbox}[colback=b1soft,colframe=b1rule,boxrule=1pt,arc=2pt,
                  left=10pt,right=10pt,top=9pt,bottom=9pt]
  {\LARGE\bfseries << titel|tex >>}\\[3pt]
  {\small\color{b1mute}<< untertitel|tex >>}
\end{tcolorbox}

\hinweisblock

