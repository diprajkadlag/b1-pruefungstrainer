<% endfor %>
<% endfor %>
\end{longtable}
}

\merke{Den Artikel lernt man nur mit dem Wort zusammen. Drei Endungen sind
  aber verlässlich: \textbf{-ung, -heit, -keit, -schaft, -tion} sind immer
  \textbf{die}; \textbf{-chen} und \textbf{-lein} immer \textbf{das};
  \textbf{-er} bei Personen und Geräten meist \textbf{der}.}

