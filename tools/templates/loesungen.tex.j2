<% endfor %>

%% ---------------- Hörtexte ----------------
\clearpage
{\Large\bfseries Hörtexte — Transkription}\par
{\color{b1rule}\hrule height 1pt}

{\small Die Sätze, die eine Lösung tragen, sind \textbf{fett} gedruckt.}

<% for teil in hoeren.teile %>
\vspace{0.7em}
{\large\bfseries Teil << teil.nummer >>}\hfill{\small\color{b1mute}<< teil.wiederholungen >>× zu hören}\par
{\color{b1edge}\hrule height 0.6pt}\vspace{0.3em}
<% for line in teil.skript %>
\noindent\makebox[7.5em][l]{\small\bfseries\color{b1mute}<< line.rolle | tex >>}%
\begin{minipage}[t]{\dimexpr\linewidth-7.5em\relax}<% if line.get('betont') %>\bfseries{}<% endif %><< line.text | tex >>\end{minipage}\par\vspace{2pt}
<% endfor %>
<% endfor %>

%% ---------------- Schreiben ----------------
\clearpage
{\Large\bfseries Modul Schreiben — Musterlösungen}\par
{\color{b1rule}\hrule height 1pt}

<% for a in schreiben.aufgaben %>
\vspace{0.7em}
{\large\bfseries Aufgabe << a.nummer >>}\quad{\color{b1mute}\small << a | aufgabenname | tex >> · ca. << a.woerter >> Wörter · << a.punkte >> Punkte}\par
{\color{b1edge}\hrule height 0.6pt}\vspace{0.3em}

<% if a.get('redemittel') %>
{\bfseries\small Nützliche Redemittel}
\begin{itemize}[leftmargin=1.4em,itemsep=1pt,topsep=3pt,label=\textbullet]
<% for r in a.get('redemittel') %>\item << r | tex >>
<% endfor %>
\end{itemize}
<% endif %>

<% for m in a.musterloesungen | sort(attribute='niveau') %>
\vspace{0.3em}
\pruefungstext{Musterlösung — << m.niveau | tex >>}{}{<< m.text | texpar >>}
\warum{\textbf{Kommentar:} << m.kommentar | tex >>}
<% endfor %>
<% endfor %>

\vspace{0.8em}
\noindent\fbox{\begin{minipage}{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}
\small\textbf{Bewertungsraster Schreiben.} Aufgaben 1 und 2: je 10 Punkte für
Erfüllung, Kohärenz, Wortschatz und Strukturen (40 Punkte).
Aufgabe 3: 4 Punkte für Erfüllung, 4 für Kohärenz, 6 für Wortschatz,
6 für Strukturen (20 Punkte). Zusammen 100 Punkte.\\[3pt]
\textbf{Wichtig:} Fehlt ein Leitpunkt vollständig, kann die Aufgabe bei
„Erfüllung“ nicht mehr als die Hälfte der Punkte bekommen.
\end{minipage}}

