\begin{minipage}[t]{\dimexpr\linewidth-6em\relax}<< p.text | tex >>\par
{\small\color{b1mute}$
ightarrow$ << p.get('hinweis') | default('') | tex >> (ca. << p.wartenSek >> Sekunden)}\end{minipage}\par\vspace{3pt}
<% endfor %>
<% endfor %>

\vspace{0.6em}
\noindent\fbox{\begin{minipage}{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}
