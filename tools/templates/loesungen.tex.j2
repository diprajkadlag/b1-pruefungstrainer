\modulkopf{Lösungen und Lernzusammenfassung}{}{Schlüssel · Transkripte · Glossar · Grammatik}
\hinweisblock

{\small Zu jeder Aufgabe finden Sie die Lösung, den Beleg im Text, eine
Begründung auf Deutsch und eine englische Erklärung dazu, warum die anderen
Optionen falsch sind. Danach folgen Musterlösungen, ein Wortschatz-Glossar mit
allen Wortformen und ein Grammatik-Teil mit Übungen.}

\vspace{0.6em}
\noindent\fbox{\begin{minipage}{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}
\small\textbf{Bewertung.} Lesen und Hören: je 30 Aufgaben, jede Aufgabe
1 Punkt. Die Rohpunkte werden auf 100 Punkte umgerechnet
(Punkte $=$ richtige Aufgaben $\times\ 10/3$). Bestanden ab \textbf{60 Punkten}
pro Modul.\\[3pt]
\textbf{sehr gut} 100–90 \quad \textbf{gut} 89–80 \quad
\textbf{befriedigend} 79–70 \quad \textbf{ausreichend} 69–60 \quad
\textbf{nicht bestanden} unter 60
\end{minipage}}

%% ---------------- Schnellübersicht ----------------
\vspace{0.9em}
{\large\bfseries Lösungsschlüssel auf einen Blick}\par
{\color{b1edge}\hrule height 0.8pt}\vspace{0.5em}

\begin{minipage}[t]{0.48\linewidth}
{\bfseries Lesen}\par\vspace{3pt}
{\ttfamily\small
<% for item in lesen | alle_items %><< "%2d" | format(item.nr) >>  << item.loesung | kurz >>\quad<% if loop.index % 3 == 0 %>\par<% endif %><% endfor %>
}
\end{minipage}\hfill
\begin{minipage}[t]{0.48\linewidth}
{\bfseries Hören}\par\vspace{3pt}
{\ttfamily\small
<% for item in hoeren | alle_items %><< "%2d" | format(item.nr) >>  << item.loesung | kurz >>\quad<% if loop.index % 3 == 0 %>\par<% endif %><% endfor %>
}
\end{minipage}

