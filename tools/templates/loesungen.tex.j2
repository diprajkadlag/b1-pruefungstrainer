\clearpage
{\Large\bfseries Modul Lesen}\par
{\color{b1rule}\hrule height 1pt}

<% for teil in lesen.teile %>
\vspace{0.7em}
{\large\bfseries Teil << teil.nummer >>}\quad{\color{b1mute}\small << teil | teilname | tex >>}\par
{\color{b1edge}\hrule height 0.6pt}\vspace{0.3em}
<% for item in teil['items'] %>
\loesungszeile{<< item.nr >>}{<< item.loesung | kurz >>}{%
  << item.frage | tex >>%
}
<% if item.get('beleg') %>\beleg{<< item.get('beleg') | tex >>}<% endif %>
\warum{<< item.begruendung.de | tex >>}
\warumen{<< item.begruendung.en | tex >>}
<% endfor %>
<% endfor %>

%% ---------------- Hören ----------------
\clearpage
{\Large\bfseries Modul Hören}\par
{\color{b1rule}\hrule height 1pt}

<% for teil in hoeren.teile %>
\vspace{0.7em}
{\large\bfseries Teil << teil.nummer >>}\quad{\color{b1mute}\small << teil | teilname | tex >>}\par
{\color{b1edge}\hrule height 0.6pt}\vspace{0.3em}
<% for item in teil['items'] %>
\loesungszeile{<< item.nr >>}{<< item.loesung | kurz >>}{%
  << item.frage | tex >>%
}
<% if item.get('beleg') %>\beleg{<< item.get('beleg') | tex >>}<% endif %>
