\documentclass[11pt]{article}
\usepackage{pruefung}

\pruefungstitel{<< meta.titel >>}
\modulname{Kandidatenblätter}
\niveaustufe{<< meta.stufe >> (Kursstufe << meta | kursstufe >>)}

\begin{document}

%% ===================== LESEN =====================
\modulname{Lesen}
\modulkopf{Modul Lesen}{<< lesen.zeitMinuten >> Minuten}{<< lesen | alle_items | length >> Aufgaben · << modulpunkte >> Punkte}
\hinweisblock

Das Modul Lesen hat << lesen.teile | length >> Teile. Sie lesen mehrere Texte und lösen dazu
Aufgaben. Schreiben Sie Ihre Lösungen am Ende auf den Antwortbogen.
Wörterbücher und Mobiltelefone sind nicht erlaubt.

<% for teil in lesen.teile %>
\teil{<< teil.nummer >>}{<< teil | teilname | tex >>}{<< teil.anweisung | tex >>}{<< teil.richtzeitMinuten >> Min.}

<% if teil.get('these') %>\pruefungstext{}{}{\textbf{<< teil.get('these') | tex >>}}<% endif %>

<# Texts, with any [10] gap markers printed as numbered blanks. #>
<% for t in teil.get('texte') or [] %>
\pruefungstext{<% if t.get('buchstabe') %><< t.get('buchstabe') >>) <% endif %><< t.titel | default('') | tex >>}{<< t.quelle | default('') | tex >>}{<< t.inhalt | luecken >>}
<% endfor %>

<# B2: the lettered alternatives the items are answered from. #>
<% if teil.get('optionenliste') %>
\vspace{0.4em}
{\bfseries Zur Auswahl}
\vspace{0.2em}
<% for o in teil.get('optionenliste') %>
\zuordnungsoption{<< o.buchstabe >>}{<< o.get('titel') | default('') | tex >>}{<< o.inhalt | tex >>}
<% endfor %>
<% endif %>

<% if teil.get('beispiel') %>
\beispielkasten{<< teil.get('beispiel') | itemmacro >>}
<% endif %>

<% for item in teil['items'] %>
<< item | itemmacro >>
<% endfor %>

<# B1 Teil 3: the ads come after the situations, as on the printed paper. #>
<% if teil.get('anzeigen') %>
\vspace{0.6em}
{\bfseries Anzeigen}
\vspace{0.2em}
<% for a in teil.get('anzeigen') %>
\anzeige{<< a.buchstabe >>}{<< a.titel | tex >>}{<< a.inhalt | tex >>}
<% endfor %>
<% endif %>
<% endfor %>

\clearpage

%% ===================== HÖREN =====================
\modulname{Hören}
\modulkopf{Modul Hören}{ca. << hoeren.zeitMinuten >> Minuten}{<< hoeren | alle_items | length >> Aufgaben · << modulpunkte >> Punkte}

Das Modul Hören hat << hoeren.teile | length >> Teile. Sie hören mehrere Texte und lösen dazu
Aufgaben. Lesen Sie zuerst die Aufgaben, hören Sie dann den Text dazu.

<% for teil in hoeren.teile %>
\teil{<< teil.nummer >>}{<< teil | teilname | tex >>}{<< teil.anweisung | tex >>}{<< teil.wiederholungen >>× hören}

<% if teil.get('situation') %>\textit{<< teil.get('situation') | tex >>}\par<% endif %>

<% if teil.get('beispiel') %>
\beispielkasten{<< teil.get('beispiel') | itemmacro >>}
<% endif %>

<# The speaker-matching part: B1 Teil 4, B2 Teil 3. Keyed on what the items
   ask for rather than on a number, and labelled from the item's own options
   so the letters on the page always match the ones being marked. #>
<% set zuordnung = teil['items'] | selectattr('typ', 'equalto', 'zuordnung_person') | list %>
<% if zuordnung %>
{\small Wer sagt das? Kreuzen Sie an:
<% for b in ['a', 'b', 'c'] %>\textbf{<< b >>} << zuordnung[0]['optionen'][b] | tex >><% if not loop.last %>, <% endif %><% endfor %>.}
<% endif %>

<% for item in teil['items'] %>
<< item | itemmacro >>
<% endfor %>
<% endfor %>

\clearpage

%% ===================== SCHREIBEN =====================
\modulname{Schreiben}
\modulkopf{Modul Schreiben}{<< schreiben.zeitMinuten >> Minuten}{<< schreiben.aufgaben | length >> Aufgaben · << schreiben.aufgaben | sum(attribute='punkte') >> Punkte}

Das Modul Schreiben hat << schreiben.aufgaben | length >> Aufgaben. Schreiben Sie Ihre Texte auf den
Antwortbogen. Achten Sie auf Anrede, Gruß und die vorgegebene Länge.

<% for a in schreiben.aufgaben %>
<# A1 opens with a form: five numbered blanks rather than a text, and no word
   count to print. Everything else in this loop assumes free writing. #>
<% if a.get('formular') %>
\schreibaufgabe{<< a.nummer >>}{<< a | aufgabenname | tex >>}{<< a.zeitMinuten >> Min.}{<< a.punkte >>}{5 Felder}{<< a.get('situation') | tex >>}{<< a.aufgabenstellung | tex >>}

\vspace{0.6em}
<% for f in a.get('formular') %>
\formularzeile{<< loop.index >>}{<< f.feld | tex >>}
<% endfor %>
\vspace{0.6em}
<% if not loop.last %>\clearpage<% endif %>
<% else %>
\schreibaufgabe{<< a.nummer >>}{<< a | aufgabenname | tex >>}{<< a.zeitMinuten >> Min.}{<< a.punkte >>}{<% if meta.stufe == 'B2' %>mind. <% else %>ca. <% endif %><< a.woerter >>}{<< a.get('situation') | tex >>}{<< a.aufgabenstellung | tex >>}

<% if a.get('impuls') %>
\pruefungstext{}{}{<< a.get('impuls') | texpar >>}
<% endif %>

\leitpunkte{<% for p in a.leitpunkte %>\item << p | tex >>
<% endfor %>}

<% if a.get('anrede') %>{\small\color{pruefmute}Beginnen Sie zum Beispiel mit:
\textit{<< a.get('anrede') | tex >>,}}\par<% endif %>

\schreiblinien{<< a.woerter | zeilen >>}
<% if not loop.last %>\clearpage<% endif %>
<% endif %>
<% endfor %>

\end{document}
