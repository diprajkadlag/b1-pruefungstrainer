% b1pruefung.sty — shared layout for every generated paper.
%
% This is an original layout for this project. It follows the well-known
% *format* of a B1 certificate examination (parts, item counts, timings)
% because that is what makes it useful for practice, but it deliberately
% reproduces no examination body's page design, typography or branding.
% See docs/DISCLAIMER.md.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{b1pruefung}[2026/07/25 B1 practice examination layout]

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[ngerman]{babel}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage[a4paper,top=2.4cm,bottom=2.2cm,left=2.4cm,right=2.4cm,%
                headheight=22pt]{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{enumitem}
\RequirePackage{tcolorbox}
\RequirePackage{xcolor}
\RequirePackage{amssymb}
\RequirePackage{graphicx}
\RequirePackage{array}
\RequirePackage{ragged2e}
\RequirePackage{needspace}
\RequirePackage[hidelinks]{hyperref}

\tcbuselibrary{skins,breakable}

% --- palette ---------------------------------------------------------------
\definecolor{b1rule}{HTML}{2F3E4E}
\definecolor{b1soft}{HTML}{F2F4F6}
\definecolor{b1edge}{HTML}{C6CDD4}
\definecolor{b1mute}{HTML}{5B6672}
\definecolor{b1mark}{HTML}{0F6C4A}

% --- document metadata, set by the generator -------------------------------
\newcommand{\pruefungstitel}[1]{\gdef\@pruefungstitel{#1}}
\newcommand{\modulname}[1]{\gdef\@modulname{#1}}
\newcommand{\niveaustufe}[1]{\gdef\@niveaustufe{#1}}
\gdef\@pruefungstitel{}\gdef\@modulname{}\gdef\@niveaustufe{}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize\color{b1mute}\@pruefungstitel}
\fancyhead[R]{\footnotesize\color{b1mute}\@modulname}
\fancyfoot[L]{\scriptsize\color{b1mute}Übungsmaterial · CC BY 4.0 · keine
  offizielle Prüfung}
\fancyfoot[R]{\scriptsize\color{b1mute}\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{b1edge}\leaders\hrule height
  \headrulewidth\hfill}}
\renewcommand{\footrule}{\hbox to\headwidth{\color{b1edge}\leaders\hrule height
  \footrulewidth\hfill}}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55em}
\linespread{1.06}

% --- title block -----------------------------------------------------------
% \modulkopf{module}{minutes}{items or points}
\newcommand{\modulkopf}[3]{%
  \begin{tcolorbox}[colback=b1soft,colframe=b1rule,boxrule=1pt,arc=2pt,
                    left=10pt,right=10pt,top=8pt,bottom=8pt]
    {\LARGE\bfseries #1}\\[2pt]
    {\small\color{b1mute}\@pruefungstitel\ · Niveau \@niveaustufe}
    \par\vspace{4pt}
    {\small\ifx\relax#2\relax\else\textbf{Zeit:} #2\fi\hfill\textbf{#3}}
  \end{tcolorbox}
  \vspace{0.4em}
}

% \teil{number}{heading}{instruction}{suggested minutes}
\newcommand{\teil}[4]{%
  \needspace{5\baselineskip}
  \vspace{0.7em}
  {\large\bfseries Teil #1}\quad{\color{b1mute}\small #2}%
  \hfill{\small\color{b1mute}empfohlen: #4}\par
  \vspace{0.15em}
  {\color{b1edge}\hrule height 0.8pt}
  \vspace{0.5em}
  \begingroup\itshape #3\par\endgroup
  \vspace{0.3em}
}

% Reading passage. \pruefungstext{title}{source}{body}
\newcommand{\pruefungstext}[3]{%
  \begin{tcolorbox}[breakable,colback=white,colframe=b1edge,boxrule=0.8pt,
                    arc=2pt,left=10pt,right=10pt,top=8pt,bottom=8pt]
    \setlength{\parskip}{0.55em}%
    \ifx\relax#1\relax\else{\bfseries #1}\par\vspace{2pt}\fi
    \ifx\relax#2\relax\else{\scriptsize\color{b1mute}#2}\par\vspace{4pt}\fi
    #3
  \end{tcolorbox}
}

% Classified advertisement. \anzeige{letter}{title}{body}
\newcommand{\anzeige}[3]{%
  \begin{tcolorbox}[colback=white,colframe=b1edge,boxrule=0.7pt,arc=2pt,
                    left=8pt,right=8pt,top=6pt,bottom=6pt,
                    before skip=4pt,after skip=4pt]
    {\bfseries\color{b1rule}#1)}\ {\bfseries #2}\par
    {\small #3}
  \end{tcolorbox}
}

% --- items -----------------------------------------------------------------
\newcommand{\antwortkasten}{$\square$}
\newcommand{\itemnr}[1]{%
  \makebox[2.8em][l]{\bfseries #1}%
}

% \itemrf{nr}{question}
\newcommand{\itemrf}[2]{%
  \needspace{2.4\baselineskip}
  \par\vspace{0.35em}
  \begingroup
  \setlength{\parskip}{0pt}
  \noindent\itemnr{#1}\begin{minipage}[t]{\dimexpr\linewidth-2.8em\relax}
    #2\par\vspace{2pt}
    {\small\antwortkasten\ Richtig\qquad\antwortkasten\ Falsch}
  \end{minipage}\par
  \endgroup
}

% \itemja{nr}{person}
\newcommand{\itemja}[2]{%
  \needspace{2.4\baselineskip}
  \par\vspace{0.35em}
  \begingroup
  \setlength{\parskip}{0pt}
  \noindent\itemnr{#1}\begin{minipage}[t]{\dimexpr\linewidth-2.8em\relax}
    \textbf{#2}\par\vspace{2pt}
    {\small\antwortkasten\ Ja (dafür)\qquad\antwortkasten\ Nein (dagegen)}
  \end{minipage}\par
  \endgroup
}

% \itemmc{nr}{question}{a}{b}{c}
\newcommand{\itemmc}[5]{%
  \needspace{5\baselineskip}
  \par\vspace{0.45em}
  \begingroup
  \setlength{\parskip}{0pt}
  \noindent\itemnr{#1}\begin{minipage}[t]{\dimexpr\linewidth-2.8em\relax}
    #2\par\vspace{3pt}
    \begin{list}{}{\leftmargin=1.6em\itemsep=1pt\parsep=0pt\topsep=0pt}
      \item[\antwortkasten\ \textbf{a}] #3
      \item[\antwortkasten\ \textbf{b}] #4
      \item[\antwortkasten\ \textbf{c}] #5
    \end{list}
  \end{minipage}\par
  \endgroup
}

% \itemzuordnung{nr}{situation}
\newcommand{\itemzuordnung}[2]{%
  \needspace{2.6\baselineskip}
  \par\vspace{0.35em}
  \begingroup
  \setlength{\parskip}{0pt}
  \noindent\itemnr{#1}\begin{minipage}[t]{\dimexpr\linewidth-6.8em\relax}
    #2
  \end{minipage}%
  \hfill\framebox[3.2em][c]{\rule{0pt}{1.5em}}\par
  \endgroup
}

% Worked example shown before the real items.
\newcommand{\beispielkasten}[1]{%
  \begin{tcolorbox}[colback=b1soft,colframe=b1edge,boxrule=0.7pt,arc=2pt,
                    left=8pt,right=8pt,top=5pt,bottom=5pt,
                    before skip=5pt,after skip=7pt]
    {\bfseries\footnotesize BEISPIEL}\par\vspace{2pt}#1
  \end{tcolorbox}
}

% --- writing and speaking --------------------------------------------------
% \schreibaufgabe{n}{type}{minutes}{points}{words}{situation}{task}
\newcommand{\schreibaufgabe}[7]{%
  \needspace{6\baselineskip}
  \vspace{0.7em}
  {\large\bfseries Aufgabe #1}\quad{\color{b1mute}\small #2}%
  \hfill{\small\color{b1mute}#3 · #4 Punkte · ca. #5 Wörter}\par
  \vspace{0.15em}{\color{b1edge}\hrule height 0.8pt}\vspace{0.5em}
  #6\par\vspace{0.3em}\textit{#7}\par
}

\newcommand{\leitpunkte}[1]{%
  \begin{itemize}[leftmargin=1.4em,itemsep=2pt,topsep=4pt,label=\textbullet]
    #1
  \end{itemize}
}

% Ruled writing space. \schreiblinien{count}
\newcommand{\schreiblinien}[1]{%
  \vspace{0.4em}
  \foreach \i in {1,...,#1}{%
    \noindent\rule{\linewidth}{0.3pt}\par\vspace{1.05em}%
  }
}
\RequirePackage{pgffor}

% Presentation slide card for Sprechen Teil 2.
\newcommand{\folie}[2]{%
  \begin{tcolorbox}[colback=white,colframe=b1rule,boxrule=0.9pt,arc=3pt,
                    left=9pt,right=9pt,top=7pt,bottom=7pt,
                    before skip=5pt,after skip=5pt]
    {\bfseries\color{b1rule}#1}\par\vspace{3pt}#2
  \end{tcolorbox}
}

% --- solution booklet ------------------------------------------------------
\newcommand{\loesungszeile}[3]{%
  \needspace{2\baselineskip}
  \par\vspace{0.3em}
  \noindent\makebox[2.2em][l]{\bfseries #1}%
  \makebox[4.5em][l]{\color{b1mark}\bfseries #2}%
  \begin{minipage}[t]{\dimexpr\linewidth-6.7em\relax}#3\end{minipage}\par
}

\newcommand{\beleg}[1]{{\small\color{b1mute}\textit{Beleg: „#1“}}\par}
\newcommand{\warum}[1]{{\small #1}\par}
\newcommand{\warumen}[1]{{\small\color{b1mute}#1}\par}

% Disclaimer, printed on the first page of every document.
\newcommand{\hinweisblock}{%
  \begin{tcolorbox}[colback=b1soft,colframe=b1edge,boxrule=0.6pt,arc=2pt,
                    left=8pt,right=8pt,top=5pt,bottom=5pt]
    {\scriptsize Dieses Übungsmaterial ist \textbf{keine offizielle Prüfung}.
    Es steht in keiner Verbindung zum Goethe-Institut e.\,V., zur telc gGmbH
    oder zum ÖSD und ist von diesen weder geprüft noch anerkannt. Alle Texte
    und Aufgaben sind eigens für dieses Projekt verfasst.
    Lizenz: CC BY 4.0.}
  \end{tcolorbox}
  \vspace{0.3em}
}

\endinput
