\documentclass[11pt]{article}
\usepackage{pruefung}

\pruefungstitel{<< meta.titel >>}
\modulname{Sprechen}
\niveaustufe{<< meta.stufe >> (Kursstufe << meta | kursstufe >>)}

\begin{document}

\modulkopf{Modul Sprechen}{ca. << sprechen.teile | sum(attribute='dauerMinuten') * 2 | round | int >> Minuten · << sprechen.vorbereitungMinuten >> Minuten Vorbereitung}{100 Punkte}
\hinweisblock

Das Modul Sprechen hat << sprechen.teile | length >> Teile und wird normalerweise zu zweit abgelegt.
Sie haben << sprechen.vorbereitungMinuten >> Minuten Zeit, sich vorzubereiten. Notizen dürfen Sie machen und
in die Prüfung mitnehmen; vorformulierte Sätze vorlesen dürfen Sie nicht.

{\small\color{pruefmute}\textbf{Ohne Partner:} Die Web-App spielt überall dort,
wo ein Gegenüber gebraucht wird, einen simulierten Partner ein und lässt Ihnen
Zeit zum Antworten. Ihre Antworten werden aufgezeichnet.}

<% for teil in sprechen.teile %>
\teil{<< teil.nummer >>}{<< teil.titel | tex >>}{<< teil.anweisung | tex >>}{ca. << teil.dauerMinuten >> Min. · << teil.punkte >> Punkte}

<% if teil.get('situation') %>
\pruefungstext{Situation}{}{<< teil.get('situation') | texpar >>}
<% endif %>

<% if teil.get('planungspunkte') %>
\leitpunkte{<% for p in teil.get('planungspunkte') %>\item << p | tex >>
<% endfor %>}
<% if teil.typ == 'diskussion' %>
{\small\color{pruefmute}Tauschen Sie Argumente aus, gehen Sie auf die Einwände
Ihrer Partnerin ein und fassen Sie am Ende zusammen, worauf Sie sich einigen
können.}
<% else %>
{\small\color{pruefmute}Machen Sie Vorschläge, reagieren Sie auf die Vorschläge
Ihres Partners und einigen Sie sich am Ende auf eine gemeinsame Lösung.}
<% endif %>
<% endif %>

<% if teil.get('themen') %>
<% for thema in teil.get('themen') %>
\needspace{10\baselineskip}
\vspace{0.6em}
{\bfseries Thema << loop.index >>: << thema.titel | tex >>}\par
\vspace{0.3em}
<# B1 numbers slides; B2 asks for a talk whose points name their own role
   ("Einleitung — …"), so the label is taken from the text where there is one. #>
<% for f in thema.folien %>
<% set teile = f.split('—') %>
<% if teile | length > 1 and not teile[0].strip().startswith('Folie') %>
\folie{<< teile[0].strip() | tex >>}{<< teile[1:] | join('—') | trim | tex >>}
<% else %>
\folie{Folie << loop.index >>}{<< f | tex | folientext >>}
<% endif %>
<% endfor %>
<% if not loop.last %>\vspace{0.5em}{\color{pruefedge}\hrule height 0.5pt}<% endif %>
<% endfor %>
{\small\color{pruefmute}Wählen Sie \textbf{eines} der beiden Themen.}
<% endif %>

<% if teil.get('fragen') %>
\leitpunkte{<% for f in teil.get('fragen') %>\item << f | tex >>
<% endfor %>}
<% endif %>
<% endfor %>

\clearpage

\modulkopf{Notizblatt}{15 Minuten Vorbereitung}{wird nicht bewertet}

{\small Notieren Sie hier Stichworte — keine ganzen Sätze. Sie dürfen dieses
Blatt in die Prüfung mitnehmen.}

<% for teil in sprechen.teile %>
\vspace{0.5em}
{\bfseries Teil << teil.nummer >> — << teil.titel | tex >>}
\schreiblinien{<% if teil.get('themen') %>16<% else %>8<% endif %>}
<% endfor %>

\end{document}
