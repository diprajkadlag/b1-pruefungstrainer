\documentclass[11pt]{article}
\usepackage{pruefung}

\pruefungstitel{<< meta.titel >>}
\modulname{Antwortbogen}
\niveaustufe{<< meta.stufe >> · << meta.niveau >>}

\newcommand{\bogenzeile}[2]{%
  \noindent\makebox[2.4em][l]{\bfseries #1}#2\par\vspace{3pt}%
}
\newcommand{\rfpaar}{\antwortkasten\ R\quad\antwortkasten\ F}
\newcommand{\jnpaar}{\antwortkasten\ Ja\quad\antwortkasten\ Nein}
\newcommand{\abcdrei}{\antwortkasten\ a\quad\antwortkasten\ b\quad\antwortkasten\ c}
\newcommand{\abcvier}{\abcdrei\quad\antwortkasten\ d}
\newcommand{\kastenfeld}{\framebox[3em][c]{\rule{0pt}{1.3em}}}

\begin{document}

\modulkopf{Antwortbogen}{}{Name: \rule{6cm}{0.4pt}\qquad Datum: \rule{3cm}{0.4pt}}
\hinweisblock

{\small Übertragen Sie Ihre Lösungen hier. Nur dieser Bogen wird bewertet.
Kreuzen Sie eindeutig an. Wo ein Kästchen zum Eintragen steht, schreiben Sie
den Buchstaben der passenden Anzeige, Äußerung oder Überschrift hinein<% if meta.stufe == 'B1' %>, oder
\textbf{0}, wenn keine passt<% endif %>.}

<% for modul, name in [(lesen, 'Lesen'), (hoeren, 'Hören')] %>
<% set spalten = modul | bogenspalten %>
\vspace{0.8em}
\begin{minipage}[t]{0.48\linewidth}
{\large\bfseries << name >>}\par
{\color{pruefedge}\hrule height 0.8pt}\vspace{0.5em}

<% for teil in spalten[0] %>
{\bfseries\small Teil << teil.nummer >> — << teil.label >>}\par\vspace{2pt}
<% for z in teil.zeilen %>\bogenzeile{<< z.nr >>}{<< z.makro >>}
<% endfor %>
\vspace{0.4em}
<% endfor %>
\end{minipage}\hfill
\begin{minipage}[t]{0.48\linewidth}
{\large\bfseries\phantom{<< name >>}}\par
{\color{white}\hrule height 0.8pt}\vspace{0.5em}

<% for teil in spalten[1] %>
{\bfseries\small Teil << teil.nummer >> — << teil.label >>}\par\vspace{2pt}
<% for z in teil.zeilen %>\bogenzeile{<< z.nr >>}{<< z.makro >>}
<% endfor %>
\vspace{0.4em}
<% endfor %>

\vspace{0.8em}
\noindent\fbox{\begin{minipage}{0.9\linewidth}\small
Punkte << name >>: \rule{1.5cm}{0.4pt} / 30 Aufgaben\\[2pt]
Ergebnis: \rule{1.5cm}{0.4pt} / 100 Punkte
\end{minipage}}
\end{minipage}

<% if not loop.last %>
\vspace{1.4em}
{\color{pruefrule}\hrule height 1pt}
<% endif %>
<% endfor %>

\clearpage

\modulkopf{Antwortbogen — Schreiben}{<< schreiben.zeitMinuten >> Minuten}{100 Punkte}

{\small Schreiben Sie hier Ihre Texte. Bitte gut lesbar.}

<% for a in schreiben.aufgaben %>
\vspace{0.5em}
{\large\bfseries Aufgabe << a.nummer >>}\hfill{\small\color{pruefmute}<% if meta.stufe == 'B2' %>mind.<% else %>ca.<% endif %> << a.woerter >> Wörter · << a.punkte >> Punkte}\par
{\color{pruefedge}\hrule height 0.8pt}
\schreiblinien{<< a.woerter | zeilen >>}
<% if not loop.last %>\clearpage<% endif %>
<% endfor %>

\end{document}
