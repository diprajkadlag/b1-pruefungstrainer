{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diprajkadlag/german-exam-trainer/packages/schema/exam.schema.json",
  "title": "Übungsprüfung B1 / B2",
  "description": "Single source of truth for one complete practice examination. Drives the PDF paper, the solution booklet, the listening audio script, the web app and the glossary. Shape is enforced here; the per-level specification (item counts per part, points, repeat counts) is enforced by tools/validate.py, which reads it from one table per level. See docs/EXAM-FORMAT.md.",
  "type": "object",
  "required": [
    "meta",
    "lesen",
    "hoeren",
    "schreiben",
    "sprechen",
    "glossar",
    "grammatik"
  ],
  "additionalProperties": false,

  "properties": {
    "$schema": { "type": "string" },

    "meta": {
      "type": "object",
      "required": [
        "id",
        "titel",
        "stufe",
        "variante",
        "niveau",
        "contentVersion",
        "themen",
        "lizenz"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(b2-)?pruefung-[0-9]{2}$",
          "description": "Folder name and stable identifier. B1 papers are pruefung-01; B2 papers carry the level as a prefix, b2-pruefung-01. The unprefixed form means B1 because those five papers shipped before the second level existed, and renaming them would have broken every stored attempt."
        },
        "titel": { "type": "string", "minLength": 3 },
        "stufe": {
          "enum": ["B1", "B2"],
          "description": "Which examination format this paper follows. Must agree with the id prefix. Selects the whole rule set: item counts, task types, module times, marking maxima."
        },
        "variante": {
          "enum": ["erwachsene", "jugendliche"],
          "description": "Topic register. Identical structure, different subject matter."
        },
        "niveau": {
          "enum": ["mittel-leicht", "mittel"],
          "description": "Difficulty band within the level. Drives speech rate and distractor transparency."
        },
        "contentVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Versioned independently of the application. Bump on any item change."
        },
        "sprechtempoProzent": {
          "type": "integer",
          "minimum": -15,
          "maximum": 0,
          "default": 0,
          "description": "Listening speech-rate offset. -8 for the gentlest paper, 0 for exam speed."
        },
        "themen": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string" },
          "description": "Topic tags. The validator enforces that papers of the same level do not overlap heavily."
        },
        "autor": { "type": "string" },
        "lizenz": { "const": "CC-BY-4.0" },
        "originalitaet": {
          "const": true,
          "default": true,
          "description": "Affirmation that all content here is original. See docs/AUTHORING.md."
        }
      }
    },

    "lesen": {
      "type": "object",
      "required": ["zeitMinuten", "teile"],
      "additionalProperties": false,
      "properties": {
        "zeitMinuten": { "const": 65 },
        "teile": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/lesenTeil" }
        }
      }
    },

    "hoeren": {
      "type": "object",
      "required": ["zeitMinuten", "teile"],
      "additionalProperties": false,
      "properties": {
        "zeitMinuten": { "const": 40 },
        "teile": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/hoerenTeil" }
        }
      }
    },

    "schreiben": {
      "type": "object",
      "required": ["zeitMinuten", "aufgaben"],
      "additionalProperties": false,
      "properties": {
        "zeitMinuten": {
          "enum": [60, 75],
          "description": "60 at B1 (three tasks), 75 at B2 (two, and far longer)."
        },
        "aufgaben": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/schreibenAufgabe" }
        }
      }
    },

    "sprechen": {
      "type": "object",
      "required": ["vorbereitungMinuten", "teile"],
      "additionalProperties": false,
      "properties": {
        "vorbereitungMinuten": { "const": 15 },
        "teile": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/sprechenTeil" }
        }
      }
    },

    "glossar": {
      "type": "array",
      "minItems": 25,
      "items": { "$ref": "#/$defs/glossarEintrag" },
      "description": "Post-exam vocabulary. Every lemma must actually occur in this paper."
    },

    "redewendungen": {
      "type": "array",
      "items": { "$ref": "#/$defs/redewendung" }
    },

    "grammatik": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/grammatikFokus" }
    }
  },

  "allOf": [
    {
      "description": "B1: three writing tasks in 60 minutes, three speaking parts.",
      "if": {
        "required": ["meta"],
        "properties": {
          "meta": { "required": ["stufe"], "properties": { "stufe": { "const": "B1" } } }
        }
      },
      "then": {
        "properties": {
          "schreiben": {
            "properties": {
              "zeitMinuten": { "const": 60 },
              "aufgaben": { "minItems": 3, "maxItems": 3 }
            }
          },
          "sprechen": {
            "properties": { "teile": { "minItems": 3, "maxItems": 3 } }
          }
        }
      }
    },
    {
      "description": "B2: two writing tasks in 75 minutes, two speaking parts.",
      "if": {
        "required": ["meta"],
        "properties": {
          "meta": { "required": ["stufe"], "properties": { "stufe": { "const": "B2" } } }
        }
      },
      "then": {
        "properties": {
          "schreiben": {
            "properties": {
              "zeitMinuten": { "const": 75 },
              "aufgaben": { "minItems": 2, "maxItems": 2 }
            }
          },
          "sprechen": {
            "properties": { "teile": { "minItems": 2, "maxItems": 2 } }
          }
        }
      }
    }
  ],

  "$defs": {
    "begruendung": {
      "type": "object",
      "required": ["de", "en"],
      "additionalProperties": false,
      "properties": {
        "de": {
          "type": "string",
          "minLength": 10,
          "description": "Why the key is correct, in German."
        },
        "en": {
          "type": "string",
          "minLength": 10,
          "description": "Why the distractors are wrong, in English."
        }
      }
    },

    "text": {
      "type": "object",
      "required": ["id", "inhalt"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "titel": { "type": "string" },
        "quelle": {
          "type": "string",
          "description": "Fictional publication name for realism. Must NOT be a real outlet."
        },
        "buchstabe": {
          "type": "string",
          "pattern": "^[a-d]$",
          "description": "B2 Lesen Teil 1 only: which of the four forum writers this post is, so an item keyed 'c' can be traced to a text."
        },
        "inhalt": {
          "type": "string",
          "minLength": 100,
          "description": "The running text. Where the task is to fill gaps (B2 Lesen Teile 2 and 5) each gap appears as its item number in square brackets, e.g. [10]."
        }
      }
    },

    "lesenTeil": {
      "type": "object",
      "required": ["nummer", "typ", "anweisung", "richtzeitMinuten", "items"],
      "additionalProperties": false,
      "properties": {
        "nummer": { "type": "integer", "minimum": 1, "maximum": 5 },
        "typ": {
          "enum": [
            "richtig_falsch",
            "multiple_choice",
            "zuordnung_anzeigen",
            "ja_nein",
            "multiple_choice_ordnung",
            "zuordnung_person",
            "satz_einfuegen",
            "zuordnung_aeusserungen",
            "zuordnung_ueberschriften"
          ],
          "description": "The task, not the item control. The last four are B2: match statements to one of four people, insert sentences into gaps, match opinions to headings, match regulation paragraphs to a table of contents."
        },
        "anweisung": { "type": "string", "minLength": 20 },
        "richtzeitMinuten": { "type": "integer", "minimum": 5, "maximum": 25 },
        "these": {
          "type": "string",
          "description": "B1 Teil 4 only: the proposition readers react to."
        },
        "texte": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "anzeigen": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "description": "B1 Teil 3 only: exactly ten classified ads, labelled a-j.",
          "items": {
            "type": "object",
            "required": ["buchstabe", "titel", "inhalt"],
            "additionalProperties": false,
            "properties": {
              "buchstabe": { "type": "string", "pattern": "^[a-j]$" },
              "titel": { "type": "string" },
              "inhalt": { "type": "string", "minLength": 30 }
            }
          }
        },
        "optionenliste": {
          "type": "array",
          "minItems": 6,
          "maxItems": 10,
          "description": "B2 Teile 2, 4 and 5: the lettered alternatives on offer. Deliberately longer than the number of items — the unused letters are the distractors. Kept separate from B1's 'anzeigen' rather than replacing it, so the five shipped B1 papers did not have to be rewritten.",
          "items": {
            "type": "object",
            "required": ["buchstabe", "inhalt"],
            "additionalProperties": false,
            "properties": {
              "buchstabe": { "type": "string", "pattern": "^[a-j]$" },
              "titel": {
                "type": "string",
                "description": "Shown above the entry. In Teil 4 this is the writer's name."
              },
              "inhalt": { "type": "string", "minLength": 5 }
            }
          }
        },
        "beispiel": { "$ref": "#/$defs/item" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      }
    },

    "hoerenTeil": {
      "type": "object",
      "required": ["nummer", "typ", "anweisung", "wiederholungen", "skript", "items"],
      "additionalProperties": false,
      "properties": {
        "nummer": { "type": "integer", "minimum": 1, "maximum": 4 },
        "typ": {
          "enum": [
            "kurztexte",
            "monolog",
            "gespraech",
            "diskussion",
            "interview",
            "vortrag"
          ],
          "description": "'interview' and 'vortrag' are the B2 shapes: a radio interview heard twice, and a short lecture heard twice."
        },
        "anweisung": { "type": "string", "minLength": 20 },
        "wiederholungen": {
          "type": "integer",
          "enum": [1, 2],
          "description": "B1 hears Teile 1 and 4 twice; B2 hears Teile 2 and 4 twice. The validator enforces the pattern per level."
        },
        "situation": {
          "type": "string",
          "description": "Scene-setting line shown on the paper."
        },
        "sprecher": {
          "type": "array",
          "minItems": 1,
          "description": "Role table. Each role is bound to one fixed voice for the whole paper.",
          "items": {
            "type": "object",
            "required": ["rolle", "geschlecht"],
            "additionalProperties": false,
            "properties": {
              "rolle": { "type": "string", "pattern": "^[A-Za-zÄÖÜäöüß0-9_ -]+$" },
              "geschlecht": { "enum": ["m", "f"] },
              "beschreibung": { "type": "string" },
              "stimme": {
                "type": "string",
                "description": "Optional explicit Piper voice override, e.g. de_DE-thorsten-high."
              }
            }
          }
        },
        "beispiel": { "$ref": "#/$defs/item" },
        "skript": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/skriptZeile" }
        },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      }
    },

    "skriptZeile": {
      "type": "object",
      "required": ["rolle", "text"],
      "additionalProperties": false,
      "properties": {
        "rolle": {
          "type": "string",
          "description": "Must match a role in the Teil's sprecher table, or be 'Sprecher' for the exam narrator."
        },
        "text": { "type": "string", "minLength": 1 },
        "abschnitt": {
          "type": "string",
          "description": "Groups lines into one sub-text, e.g. 'text_1'. Teil 1 has five of these."
        },
        "pauseDanachSek": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "default": 0.4
        },
        "akustik": {
          "enum": ["studio", "telefon", "mailbox", "durchsage", "radio", "raum"],
          "default": "studio",
          "description": "Acoustic staging applied by the audio pipeline. See docs/AUDIO.md."
        },
        "betont": {
          "type": "boolean",
          "default": false,
          "description": "Slightly slower and more deliberate; use for the line carrying an answer."
        }
      }
    },

    "item": {
      "type": "object",
      "required": ["nr", "typ", "frage", "loesung", "begruendung"],
      "additionalProperties": false,
      "properties": {
        "nr": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 30 },
            { "const": 0, "description": "Beispiel." }
          ]
        },
        "typ": {
          "enum": [
            "richtig_falsch",
            "multiple_choice",
            "zuordnung_anzeigen",
            "ja_nein",
            "zuordnung_person",
            "zuordnung_buchstabe"
          ],
          "description": "The control the candidate uses. 'zuordnung_buchstabe' covers every B2 task where the answer is one letter from the Teil's optionenliste — inserting a sentence, matching an opinion, matching a paragraph. The three read very differently on paper but are one and the same decision, so they share an item type and are told apart by the Teil's typ."
        },
        "frage": { "type": "string", "minLength": 5 },
        "textId": {
          "type": "string",
          "description": "Which text this item belongs to, for multi-text Teile."
        },
        "abschnitt": {
          "type": "string",
          "description": "Which listening sub-text this item belongs to."
        },
        "optionen": {
          "type": "object",
          "additionalProperties": false,
          "description": "Multiple choice and person-matching only. Three options everywhere except B2 Lesen Teil 1, which matches statements to four named people.",
          "properties": {
            "a": { "type": "string", "minLength": 1 },
            "b": { "type": "string", "minLength": 1 },
            "c": { "type": "string", "minLength": 1 },
            "d": { "type": "string", "minLength": 1 }
          },
          "required": ["a", "b", "c"]
        },
        "loesung": {
          "description": "Which key is legal depends on the item's typ; that pairing is enforced by tools/validate.py (VALID_LOESUNG), not here. anyOf, not oneOf: 'a'-'c' are legal both as multiple-choice keys and as letters from a list, and oneOf would reject them for matching twice.",
          "anyOf": [
            { "enum": ["richtig", "falsch"] },
            { "enum": ["ja", "nein"] },
            { "enum": ["a", "b", "c", "d"] },
            {
              "type": "string",
              "pattern": "^[a-j0]$",
              "description": "A letter from the Teil's ad or option list, or 0 for 'none suitable'."
            }
          ]
        },
        "beleg": {
          "type": "string",
          "description": "The exact sentence in the text or script that proves the key. Required for every scored item."
        },
        "begruendung": { "$ref": "#/$defs/begruendung" },
        "kompetenz": {
          "enum": [
            "globalverstehen",
            "detailverstehen",
            "selektivverstehen",
            "meinung_haltung",
            "zuordnen",
            "textstruktur"
          ],
          "description": "Skill tested. Drives the personalised weak-spot report. 'textstruktur' is what B2's sentence-insertion task actually measures: following how a text is put together."
        }
      }
    },

    "schreibenAufgabe": {
      "type": "object",
      "required": [
        "nummer",
        "typ",
        "situation",
        "aufgabenstellung",
        "leitpunkte",
        "woerter",
        "zeitMinuten",
        "punkte",
        "musterloesungen"
      ],
      "additionalProperties": false,
      "properties": {
        "nummer": { "type": "integer", "minimum": 1, "maximum": 3 },
        "typ": {
          "enum": [
            "email_informell",
            "forumsbeitrag",
            "email_halbformell",
            "nachricht_formell"
          ],
          "description": "'nachricht_formell' is the B2 second task: a message to a superior or an institution, where register carries marks."
        },
        "situation": { "type": "string", "minLength": 20 },
        "impuls": {
          "type": "string",
          "description": "The forum post or message being responded to."
        },
        "aufgabenstellung": { "type": "string", "minLength": 20 },
        "leitpunkte": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": { "type": "string" },
          "description": "The content points the candidate must cover."
        },
        "anrede": {
          "type": "string",
          "description": "Expected register cue, e.g. 'Liebe Sofia' vs 'Sehr geehrte Frau Berger'."
        },
        "woerter": {
          "type": "integer",
          "enum": [40, 80, 100, 150],
          "description": "B1 targets 80/80/40; B2 asks for a minimum of 150 and 100."
        },
        "zeitMinuten": { "type": "integer", "enum": [15, 20, 25, 50] },
        "punkte": { "type": "integer", "enum": [20, 40, 60] },
        "redemittel": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Useful phrases, shown only in the solution booklet."
        },
        "musterloesungen": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "description": "One 'ausreichend' and one 'gut' answer, annotated so the difference is visible.",
          "items": {
            "type": "object",
            "required": ["niveau", "text", "kommentar"],
            "additionalProperties": false,
            "properties": {
              "niveau": { "enum": ["ausreichend", "gut"] },
              "text": { "type": "string", "minLength": 40 },
              "kommentar": { "type": "string", "minLength": 30 }
            }
          }
        }
      }
    },

    "sprechenTeil": {
      "type": "object",
      "required": ["nummer", "typ", "titel", "anweisung", "dauerMinuten", "punkte"],
      "additionalProperties": false,
      "properties": {
        "nummer": { "type": "integer", "minimum": 1, "maximum": 3 },
        "typ": {
          "enum": [
            "gemeinsam_planen",
            "praesentation",
            "rueckmeldung",
            "vortrag",
            "diskussion"
          ],
          "description": "'vortrag' and 'diskussion' are the two B2 parts: a structured talk with follow-up questions, then a debate on a set question."
        },
        "titel": { "type": "string" },
        "anweisung": { "type": "string", "minLength": 20 },
        "dauerMinuten": { "type": "number", "minimum": 1, "maximum": 6 },
        "punkte": { "type": "integer", "enum": [16, 28, 40, 50] },
        "situation": {
          "type": "string",
          "description": "B1 Teil 1: what is being planned. B2 Teil 2: the debate question itself."
        },
        "planungspunkte": {
          "type": "array",
          "items": { "type": "string" },
          "description": "B1 Teil 1: the bullet points on the planning card. B2 Teil 2: the aspects the debate should touch."
        },
        "themen": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "description": "The candidate chooses one of exactly two topics. B1 Teil 2 and B2 Teil 1.",
          "items": {
            "type": "object",
            "required": ["titel", "folien"],
            "additionalProperties": false,
            "properties": {
              "titel": { "type": "string" },
              "folien": {
                "type": "array",
                "minItems": 3,
                "maxItems": 5,
                "items": { "type": "string" },
                "description": "The outline printed on the card. B1: five slides (Thema nennen / eigene Erfahrung / Situation im Heimatland / Vor- und Nachteile / Abschluss). B2: four points (Einleitung / Hauptteil mit Beispielen / Vor- und Nachteile / Schluss mit eigener Meinung), because B2 asks for a talk rather than a slide sequence."
              },
              "redemittel": { "type": "array", "items": { "type": "string" } },
              "musterantwort": { "type": "string", "minLength": 100 }
            }
          }
        },
        "partnerSkript": {
          "type": "array",
          "description": "Solo mode: TTS partner turns, with gaps for the candidate to answer.",
          "items": {
            "type": "object",
            "required": ["text", "wartenSek"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string", "minLength": 3 },
              "wartenSek": { "type": "number", "minimum": 3, "maximum": 90 },
              "hinweis": {
                "type": "string",
                "description": "On-screen cue shown while the candidate answers."
              }
            }
          }
        },
        "fragen": {
          "type": "array",
          "items": { "type": "string" },
          "description": "B1 Teil 3: feedback questions about the partner's presentation. B2 Teil 1: the questions put to the candidate after the talk."
        }
      }
    },

    "glossarEintrag": {
      "type": "object",
      "required": ["lemma", "wortart", "bedeutung_en", "beispiel", "fundstelle"],
      "additionalProperties": false,
      "properties": {
        "lemma": { "type": "string", "minLength": 2 },
        "wortart": {
          "enum": [
            "nomen",
            "verb",
            "adjektiv",
            "adverb",
            "praeposition",
            "konjunktion",
            "wendung"
          ]
        },
        "artikel": {
          "enum": ["der", "die", "das"],
          "description": "Nouns only. Required by the validator."
        },
        "plural": {
          "type": "string",
          "description": "Nouns only, e.g. 'die Verträge' or '-e'."
        },
        "stammformen": {
          "type": "object",
          "description": "Verbs only. Required by the validator.",
          "required": ["praesens_3sg", "praeteritum", "perfekt"],
          "additionalProperties": false,
          "properties": {
            "praesens_3sg": { "type": "string" },
            "praeteritum": { "type": "string" },
            "perfekt": {
              "type": "string",
              "description": "With the auxiliary, e.g. 'hat beworben'."
            },
            "unregelmaessig": { "type": "boolean", "default": false }
          }
        },
        "trennbar": { "type": "boolean", "description": "Verbs only: separable prefix." },
        "praeposition": {
          "type": "object",
          "description": "Verb or adjective governing a preposition, e.g. sich bewerben um + Akkusativ.",
          "required": ["wort", "kasus"],
          "additionalProperties": false,
          "properties": {
            "wort": { "type": "string" },
            "kasus": { "enum": ["Akkusativ", "Dativ", "Genitiv"] }
          }
        },
        "bedeutung_de": {
          "type": "string",
          "description": "German definition or synonym."
        },
        "bedeutung_en": { "type": "string", "minLength": 2 },
        "beispiel": {
          "type": "string",
          "minLength": 10,
          "description": "The sentence as it appears in this paper."
        },
        "fundstelle": {
          "type": "string",
          "pattern": "^(Lesen|Hören|Schreiben|Sprechen) Teil [1-5]$",
          "description": "Where in the paper it occurred."
        },
        "niveau": { "enum": ["A2", "B1", "B1+", "B2", "B2+"], "default": "B1" }
      }
    },

    "redewendung": {
      "type": "object",
      "required": ["wendung", "bedeutung_de", "bedeutung_en", "beispiel", "fundstelle"],
      "additionalProperties": false,
      "properties": {
        "wendung": { "type": "string", "minLength": 4 },
        "typ": {
          "enum": ["redewendung", "kollokation", "nomen_verb_verbindung"],
          "default": "kollokation"
        },
        "bedeutung_de": { "type": "string", "minLength": 5 },
        "bedeutung_en": { "type": "string", "minLength": 5 },
        "beispiel": { "type": "string", "minLength": 10 },
        "fundstelle": {
          "type": "string",
          "pattern": "^(Lesen|Hören|Schreiben|Sprechen) Teil [1-5]$"
        }
      }
    },

    "grammatikFokus": {
      "type": "object",
      "required": [
        "phaenomen",
        "erklaerung_de",
        "erklaerung_en",
        "belegSatz",
        "fundstelle",
        "uebungen"
      ],
      "additionalProperties": false,
      "properties": {
        "phaenomen": {
          "type": "string",
          "minLength": 3,
          "description": "e.g. 'Konjunktiv II der Höflichkeit'."
        },
        "erklaerung_de": { "type": "string", "minLength": 30 },
        "erklaerung_en": { "type": "string", "minLength": 30 },
        "belegSatz": {
          "type": "string",
          "minLength": 10,
          "description": "The real sentence from this paper that exhibits the phenomenon."
        },
        "fundstelle": {
          "type": "string",
          "pattern": "^(Lesen|Hören|Schreiben|Sprechen) Teil [1-5]$"
        },
        "uebungen": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["aufgabe", "loesung"],
            "additionalProperties": false,
            "properties": {
              "aufgabe": { "type": "string", "minLength": 5 },
              "loesung": { "type": "string", "minLength": 1 },
              "hinweis": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
